# Observability Stack — Environment Variables
# Copy to .env and fill in values before running: docker compose --env-file .env up -d

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=postgres

# Langfuse
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
SALT=CHANGE_ME_RANDOM_32_CHARS

# Webhook Bridge (observability → omo)
LANGFUSE_API_KEY=
OMO_WEBHOOK_URL=http://localhost:9100/webhook
POLL_INTERVAL=60
