# Observability Stack — Environment Variables
# Copy to .env and fill in values before running: docker compose --env-file .env up -d

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgres

# Langfuse
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_32_CHARS
SALT=CHANGE_ME_RANDOM_32_CHARS
